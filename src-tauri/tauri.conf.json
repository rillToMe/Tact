{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Search Short",
  "version": "0.1.0",
  "identifier": "com.searchshort.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:58080",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "search",
        "create": false,
        "title": "Search Short",
        "width": 652,
        "height": 88,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false
      },
      {
        "label": "settings",
        "create": false,
        "title": "Settings — Search Short",
        "url": "settings.html",
        "width": 520,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true,
        "shadow": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

